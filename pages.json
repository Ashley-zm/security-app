{
  "pages": [
    {
      "path": "pages/login/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": true
      }
    },
    {
      "path": "pages/home/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/work-order/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 80,
				"app-plus": {
					"bounce": "none"
				}
      }
    },
    {
      "path": "pages/statistics/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/message/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationStyle": "custom",
				"disableScroll": true,
				"app-plus": {
					"bounce": "none"
				}
      }
    },
    {
      "path": "pages/assistant/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/plugin-check/index",
      "style": {
        "navigationStyle": "custom"
      }
    },
    {
      "path": "pages/audio-record/index",
      "style": {
        "navigationStyle": "custom"
      }
    },{
      "path": "pages/work-order/person-list",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "onReachBottomDistance": 80,
				"app-plus": {
					"bounce": "none"
				}
      }
    },
    {
      "path": "pages/work-order/user-detail",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "app-plus": {
          "bounce": "none"
        }
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "安检APP",
    "navigationBarBackgroundColor": "#F5F8FF",
    "backgroundColor": "#F5F8FF"
  },
  "tabBar": {
    "color": "#6B7897",
    "selectedColor": "#1677FF",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "height": "58px",
    "list": [
      {
        "pagePath": "pages/home/index",
        "text": "首页",
        "iconPath": "static/tabbar/home.png",
        "selectedIconPath": "static/tabbar/home-active.png"
      },
      {
        "pagePath": "pages/work-order/index",
        "text": "工单",
        "iconPath": "static/tabbar/work-order.png",
        "selectedIconPath": "static/tabbar/work-order-active.png"
      },
      {
        "pagePath": "pages/statistics/index",
        "text": "统计",
        "iconPath": "static/tabbar/statistics.png",
        "selectedIconPath": "static/tabbar/statistics-active.png"
      },
      {
        "pagePath": "pages/message/index",
        "text": "消息",
        "iconPath": "static/tabbar/message.png",
        "selectedIconPath": "static/tabbar/message-active.png"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的",
        "iconPath": "static/tabbar/mine.png",
        "selectedIconPath": "static/tabbar/mine-active.png"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  }
}
